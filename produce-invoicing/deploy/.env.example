# Copy to deploy/.env and fill in locally. deploy/.env is git-ignored. NEVER commit real values.
POSTGRES_DB=produce_invoicing
POSTGRES_USER=pi_app
# Generate a long random value, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Interface the API listens on. Default 127.0.0.1 (this machine only).
# For the office LAN set this to the server's reserved LAN address (DHCP reservation).
PI_API_BIND=127.0.0.1
PI_API_PORT=8080

# true ONLY on developer machines: inserts clearly-labelled synthetic fixtures.
PI_SEED_SYNTHETIC=false
